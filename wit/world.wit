package privasys:brave-search;

/// MCP-callable Brave Web Search wrapper, executed inside an
/// attestable enclave.
///
/// ## Configure-then-freeze
///
/// The Brave Search subscription token is **not** read from any env
/// variable. Instead the app boots in the configure-only state
/// (because `set-api-key` is decorated `@config-api`): every other
/// export returns `"app is awaiting initial configuration"` until
/// the deployer calls `set-api-key` over RA-TLS. After the call the
/// app lifts its own freeze gate and the search endpoints become
/// callable. The freeze is re-armed on every enclave restart, so
/// the deployer must re-inject the key when the enclave reboots.
///
/// Only the app owner (a caller bearing the platform `manager`
/// role) may invoke the `@config-api` export — this is enforced by
/// the host runtime regardless of any `@auth` annotation.
world brave-search {
    // ── WASI imports ──────────────────────────────────────────────
    import wasi:io/error@0.2.0;
    import wasi:io/poll@0.2.0;
    import wasi:io/streams@0.2.0;
    import wasi:filesystem/types@0.2.0;
    import wasi:filesystem/preopens@0.2.0;

    // ── Enclave OS platform imports ──────────────────────────────
    import privasys:enclave-os/https@0.1.0;
    import privasys:enclave-os/attestation@0.1.0;

    /// A single Brave Web Search hit, normalised to the fields a
    /// chat assistant typically wants to cite.
    record search-hit {
        /// Page title.
        title: string,
        /// Result URL.
        url: string,
        /// Short text snippet from the page (Brave's `description`).
        description: string,
    }

    /// Bundled search response. `error` is non-empty when Brave
    /// returns a non-2xx status or `BRAVE_API_KEY` is missing, in
    /// which case `hits` is empty.
    record search-response {
        /// Original query echoed back, useful for tool-call audit.
        query: string,
        /// Up to `count` parsed hits.
        hits: list<search-hit>,
        /// Empty on success; human-readable error otherwise.
        error: string,
    }

    /// Search the public web and return a ranked list of result
    /// pages (title, URL, short description). Use this whenever the
    /// user asks a factual question, requests current or recent
    /// information, wants to look something up online, or refers to
    /// a topic, person, product, event, or page you don't already
    /// know about. Prefer calling this over guessing.
    /// @auth public
    export search: func(
        /// Free-text web search query, e.g. "weather in Paris today"
        /// or "latest react 19 release notes".
        query: string,
        /// Number of results to return (1..=20). Pass 0 for the
        /// default of 10.
        count: u32,
    ) -> search-response;

    /// Same as `search` but returns the raw JSON response from the
    /// underlying search provider so the caller can extract extra
    /// fields (snippets, FAQ, infobox, related queries).
    /// @auth public
    export search-raw: func(
        /// Free-text web search query.
        query: string,
        /// Number of results (1..=20; 0 → default 10).
        count: u32,
    ) -> string;

    /// Install the search-provider API key. Owner-only configuration
    /// call; not for model use. Returning `ok` lifts the configure-only
    /// freeze gate: the runtime auto-unfreezes on a successful config_api
    /// return (wasm-v0.36.0+), so the app no longer calls
    /// `set-config-complete`. Returns `err` when the key is empty/invalid.
    /// @config-api
    /// @auth owner
    export set-api-key: func(
        /// Web-search subscription token (sent verbatim as the
        /// provider's subscription header on outbound requests).
        api-key: string,
    ) -> result<_, string>;
}
