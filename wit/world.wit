package privasys:brave-search;

/// MCP-callable Brave Web Search wrapper, executed inside an
/// attestable enclave.
///
/// ## Configure-then-freeze
///
/// The Brave Search subscription token is **not** read from any env
/// variable. Instead the app boots in the configure-only state
/// (because `set-api-key` is decorated `@config-api`): every other
/// export returns `"app is awaiting initial configuration"` until
/// the deployer calls `set-api-key` over RA-TLS. After the call the
/// app lifts its own freeze gate and the search endpoints become
/// callable. The freeze is re-armed on every enclave restart, so
/// the deployer must re-inject the key when the enclave reboots.
///
/// Only the app owner (a caller bearing the platform `manager`
/// role) may invoke the `@config-api` export — this is enforced by
/// the host runtime regardless of any `@auth` annotation.
world brave-search {
    // ── WASI imports ──────────────────────────────────────────────
    import wasi:io/error@0.2.0;
    import wasi:io/poll@0.2.0;
    import wasi:io/streams@0.2.0;

    // ── Enclave OS platform imports ──────────────────────────────
    import privasys:enclave-os/https@0.1.0;
    import privasys:enclave-os/attestation@0.1.0;

    /// A single Brave Web Search hit, normalised to the fields a
    /// chat assistant typically wants to cite.
    record search-hit {
        /// Page title.
        title: string,
        /// Result URL.
        url: string,
        /// Short text snippet from the page (Brave's `description`).
        description: string,
    }

    /// Bundled search response. `error` is non-empty when Brave
    /// returns a non-2xx status or `BRAVE_API_KEY` is missing, in
    /// which case `hits` is empty.
    record search-response {
        /// Original query echoed back, useful for tool-call audit.
        query: string,
        /// Up to `count` parsed hits.
        hits: list<search-hit>,
        /// Empty on success; human-readable error otherwise.
        error: string,
    }

    /// Run a Brave Web Search query inside the enclave.
    ///
    /// `query` is the user-supplied search string (URL-encoded
    /// before transmission). `count` is clamped to the [1, 20] range
    /// the Brave API enforces; pass 0 to use the default of 10.
    /// @auth public
    export search: func(
        /// Search terms (free text, treated as a single Brave query).
        query: string,
        /// Desired number of hits (clamped to 1..=20; 0 → default 10).
        count: u32,
    ) -> search-response;

    /// Same as `search` but returns the raw Brave JSON body so the
    /// caller can extract additional fields (e.g. `extra_snippets`,
    /// faq, infobox) without redeploying the app.
    /// @auth public
    export search-raw: func(
        /// Search terms (free text).
        query: string,
        /// Desired number of hits (clamped to 1..=20; 0 → default 10).
        count: u32,
    ) -> string;

    /// Install the Brave Search subscription token into the enclave
    /// and lift the configure-only freeze gate so `search` /
    /// `search-raw` become callable.
    ///
    /// The token is held in enclave-process memory only — it is
    /// never persisted to the sealed KV store and never crosses an
    /// untrusted boundary. On enclave restart the freeze is re-armed
    /// and the deployer must call this function again before traffic
    /// can flow.
    ///
    /// Returns an `err(string)` when `api-key` is empty or when
    /// `attestation.set-config-complete` rejects the call.
    /// @config-api
    /// @auth owner
    export set-api-key: func(
        /// Brave Search subscription token (sent verbatim as the
        /// `X-Subscription-Token` header on outbound requests).
        api-key: string,
    ) -> result<_, string>;
}
